{
  "name": "immortals",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:performance": "node scripts/performance-baseline.mjs",
    "test:browser:phase1": "npm run test:browser && npm run test:performance",
    "verify": "npm run build && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^149.0.0",
    "@types/node": "^26.4.0",
    "playwright": "^1.62.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@types/three": "^0.185.1",
    "three": "^0.185.1"
  }
}
